# Copy to .env and fill in. Never commit .env.

# --- NCBI E-utilities (ClinVar + PubMed) ---
# Email is REQUIRED by NCBI usage policy. An API key raises the rate limit
# from 3 to 10 requests/sec. Get one at https://www.ncbi.nlm.nih.gov/account/
VARIANTSCRIBE_NCBI_EMAIL=you@example.com
VARIANTSCRIBE_NCBI_API_KEY=

# --- LLM agent (Phase 1: Anthropic) ---
VARIANTSCRIBE_ANTHROPIC_API_KEY=
VARIANTSCRIBE_AGENT_MODEL=claude-sonnet-4-6

# --- Models (HF hub ids; downloaded on first use) ---
VARIANTSCRIBE_EMBEDDING_MODEL=ncbi/MedCPT-Article-Encoder
VARIANTSCRIBE_RERANKER_MODEL=ncbi/MedCPT-Cross-Encoder

# --- Langfuse tracing (optional; tracing is a no-op unless both keys are set) ---
VARIANTSCRIBE_LANGFUSE_PUBLIC_KEY=
VARIANTSCRIBE_LANGFUSE_SECRET_KEY=
VARIANTSCRIBE_LANGFUSE_HOST=https://cloud.langfuse.com

# --- Paths ---
VARIANTSCRIBE_DATA_DIR=./data
